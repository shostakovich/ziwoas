{%- comment -%}
  Raumluft: merge_variables from Ziwoas.Trmnl.SensorPayload.
    stand: "HH:MM", local time of the push
    stand_at: UTC epoch seconds of the push; older than 30 min at render time shows the stale state;
      a push from an earlier local day shows its weekday („Stand Mo 21:40“)
    trend_from, trend_to: "HH:MM", local start and end of the trend's quarter hours; the hour ticks
      count from trend_from
    room: room name, e.g. "Wohnzimmer"
    source: "sen66" | "switchbot" | null, where CO₂ comes from, else the sensor serving the other
      values; null = nothing fresh
    lead: "sen66" | "switchbot" | null, the room's lead sensor; null without a room
    lead_fresh: true | false, whether the lead's newest reading is fresh; false when it never reported
    lead_off_since: "HH:MM" | "DD.MM." | null, time of the lead's last reading while it is not fresh,
      its date once older than 20 h; null while fresh or when it never reported
    stand_in_since: "HH:MM" | "DD.MM." | null, time of the stand-in's (SwitchBot's) last reading while
      the lead is not fresh or the stand-in serves a quantity; null in a room without a stand-in
    data_until: "HH:MM" | null, the later of the lead's and the stand-in's last reading
    verdict: "good" | "warn" | "bad" | null, air verdict (worst level of co2, pm2_5, pm10, voc, nox)
    verdict_because: quantities at the verdict level, e.g. ["co2", "pm2_5"]
    values: {co2, pm2_5, pm10, voc, nox, temperature, humidity}, numbers or null;
      co2, voc, nox, humidity integers; pm2_5, pm10, temperature one decimal
    levels: same keys, "good" | "warn" | "bad" | null
    stand_in: quantities the SwitchBot serves right now, e.g. ["co2", "temperature", "humidity"]
    co2_trend: 12 quarter-hour CO₂ means of the last 3 h, oldest first, nulls for gaps
    co2_trend_stand_in: indexes into co2_trend whose quarter hour came from the SwitchBot, e.g. [9, 10, 11];
      drawn as a long-dashed line (8/4) without area fill
    balcony: {temperature, humidity, humidity_indoors} | null, fresh outdoor reading;
      humidity_indoors = relative humidity of the balcony air at room temperature, integer % or null;
      shown as „Balkon 21,0 °C · 70 % · bei 26,5 °C: 51 %“ while the shown hint dries or humidifies
    hint: ventilation hint, a list from "cools", "warms", "dries", "humidifies", or null;
      footer row 1: verdict, reason (1–3 „A, B und C“, 4 or more „Vier Werte“), then the hint;
      with warn/bad the hint is dropped when the row would not fit, and the conversion with it
  A null voc/nox while a SEN66 leads and is fresh shows as start-up („läuft an“).
  Labels in the pixel font write „CO2“ (it has no ₂ glyph); Inter text writes „CO₂“.
  Edit here, preview with `trmnlp serve`, deploy with `trmnlp push`.
{%- endcomment -%}

<style>
  .ra-body { display: grid; grid-template-rows: 342px 69px; grid-template-columns: minmax(0, 1fr); width: 100%; height: 411px; }
  .ra-main { display: grid; grid-template-columns: 340px minmax(0, 1fr); column-gap: 24px; }
  .ra-head { display: flex; align-items: center; justify-content: space-between; height: 30px; }
  .ra-slot { height: 92px; }
  .ra-big { display: flex; align-items: baseline; gap: 10px; }
  .ra-numeral { line-height: 92px; margin-left: -6px; }
  .ra-unit { position: relative; }
  .ra-unit-level { position: absolute; left: 0; bottom: 54px; width: max-content; max-width: none; }
  .ra-cells { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, 114px); column-gap: 24px; }
  .ra-rule { position: relative; padding-top: 10px; }
  .ra-rule::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--gray-55, #AAAAAA); }
  .ra-rule--bridge::before { right: -24px; }
  .ra-row3 { grid-row: 3; }
  .ra-detail { padding-top: 161px; }
  .ra-headline { font-size: 30px; line-height: 92px; }
  .ra-note { grid-column: 1 / span 2; grid-row: 1 / span 2; display: flex; flex-direction: column; justify-content: center; gap: 6px; }
  .ra-base { display: flex; align-items: baseline; gap: 6px; height: 60px; }
  .ra-base .value--large { line-height: 60px; }
  .ra-chip { padding: 1px 6px; border-radius: 4px; }
  .ra-chip--line { padding: 1px 8px; line-height: 22px; border-radius: 4px; }
  .ra-trend { height: 214px; margin-top: 6px; }
  .ra-foot { display: grid; grid-template-rows: 29px 24px; margin-top: 8px; padding-top: 6px; border-top: 2px solid currentColor; }
  .ra-line { display: flex; align-items: center; gap: 16px; white-space: nowrap; min-width: 0; }
  .ra-line--split { justify-content: space-between; }
  .ra-line--baseline { align-items: baseline; }
  .ra-fit { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .ra-keep { flex-shrink: 0; }
</style>

{%- comment -%} State {%- endcomment -%}
{%- assign now_at = "now" | date: "%s" | plus: 0 -%}
{%- assign push_age = 0 -%}
{%- if stand_at -%}{%- assign push_age = now_at | minus: stand_at -%}{%- endif -%}
{%- assign stale = false -%}
{%- if push_age > 1800 -%}{%- assign stale = true -%}{%- endif -%}
{%- assign fresh = true -%}
{%- if source == nil or stale -%}{%- assign fresh = false -%}{%- endif -%}
{%- assign lead_off = "" -%}
{%- if lead and lead_fresh == false -%}
  {%- capture lead_off -%}{% if lead == "switchbot" %}SwitchBot{% else %}SEN66{% endif %}: keine Daten{% if lead_off_since %} seit {{ lead_off_since }}{% endif %}{%- endcapture -%}
{%- endif -%}
{%- assign starting = false -%}
{%- if lead == "sen66" and lead_fresh -%}{%- assign starting = true -%}{%- endif -%}
{%- assign lead_only_missing = false -%}
{%- if values.pm2_5 == nil and values.pm10 == nil and values.voc == nil and values.nox == nil and lead == "sen66" and lead_fresh == false -%}
  {%- assign lead_only_missing = true -%}
{%- endif -%}
{%- assign co2 = values.co2 -%}
{%- if fresh == false -%}{%- assign co2 = nil -%}{%- endif -%}
{%- capture last_push -%}
  {%- assign push_day = stand_at | plus: trmnl.user.utc_offset | divided_by: 86400 -%}
  {%- assign today = now_at | plus: trmnl.user.utc_offset | divided_by: 86400 -%}
  {%- if stand_at and push_day < today -%}
    {%- assign weekday = push_day | plus: 4 | modulo: 7 -%}
    {{- "So,Mo,Di,Mi,Do,Fr,Sa" | split: "," | slice: weekday | first }} {% endif -%}{{ stand }}
{%- endcapture -%}

<div class="layout">
  <div class="ra-body">
    <div class="ra-main">

      {%- comment -%} Left: CO₂ with level and 3-hour trend on a fixed 400–1600 ppm scale {%- endcomment -%}
      <div>
        <div class="ra-head">
          {%- if fresh == false -%}
            <span class="label text--gray-30">CO2</span>
          {%- else -%}
            <span class="label">CO2{% if stand_in contains "co2" %} · SwitchBot {{ stand_in_since }}{% endif %}</span>
          {%- endif -%}
        </div>
        <div class="ra-slot">
          {%- if co2 -%}
            <div class="ra-big">
              <span class="value value--xxlarge value--tnums ra-numeral">{{ co2 }}</span>
              <span class="ra-unit">
                {%- case levels.co2 -%}
                  {%- when "bad" -%}<span class="label ra-chip ra-unit-level bg--black text--white">hoch</span>
                  {%- when "warn" -%}<span class="label ra-chip ra-unit-level bg--gray-30 text--white">erhöht</span>
                  {%- when "good" -%}<span class="label ra-unit-level text--gray-30">gut</span>
                {%- endcase -%}
                <span class="label text--gray-30">ppm</span>
              </span>
            </div>
          {%- else -%}
            <div class="value ra-headline">Keine aktuellen Daten</div>
          {%- endif -%}
        </div>

        {%- assign known = co2_trend | compact -%}
        {%- if known.size > 1 -%}
          {%- assign live = true -%}
          {%- if co2 == nil or co2_trend.last == nil -%}{%- assign live = false -%}{%- endif -%}
          {%- assign trend_id = "ra-trend-" | append_random -%}
          <div id="{{ trend_id }}" class="ra-trend" aria-hidden="true"></div>
          <script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
          <script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
          <script>
            // plugins.js loads as a module, so TRMNLPaint and TRMNLCharts exist only once the DOM is parsed.
            document.addEventListener("DOMContentLoaded", function () {
              var el = "{{ trend_id }}";
              var trend = [{% for v in co2_trend %}{% if v == nil %}null{% else %}{{ v }}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}];
              var live = {{ live }};
              var standIn = live ? [{{ co2_trend_stand_in | join: "," }}] : [];
              var endLabel = {% if live == false and co2_trend.last == nil and data_until %}"{{ data_until }}"{% else %}null{% endif %};
              var from = "{{ trend_from }}".split(":");

              function px(n) { return TRMNLPaint.px(n, { el: el }); }
              function paint(token) { return TRMNLCharts.paint(token, { el: el }); }
              function known(i) { return trend[i] !== null && trend[i] !== undefined; }

              // Each point sits in the middle of its quarter hour, so the hour ticks fall between points.
              var quarter = 15;
              var firstMinute = Number(from[0]) * 60 + Number(from[1]) + quarter / 2;
              var lastIndex = trend.length - 1;
              var hourTicks = [];
              for (var m = Math.ceil(firstMinute / 60) * 60; m <= firstMinute + lastIndex * quarter; m += 60) {
                hourTicks.push((m - firstMinute) / quarter);
              }
              function hourAt(index) {
                var hour = Math.round((firstMinute + index * quarter) / 60) % 24;
                return (hour < 10 ? "0" : "") + hour + ":00";
              }

              var lastKnown = -1;
              trend.forEach(function (v, i) { if (v !== null) lastKnown = i; });
              var points = trend.map(function (v, i) {
                if (v === null) return { x: i, y: null };
                var point = { x: i, y: Math.min(1600, Math.max(400, v)) };
                if (live && i === lastIndex) {
                  point.marker = { enabled: true, radius: px(5) };
                } else if (!known(i - 1) && !known(i + 1)) {
                  point.marker = { enabled: true, radius: px(2) };
                }
                if (endLabel && i === lastKnown) {
                  point.dataLabels = { enabled: true, format: endLabel, y: -px(4) };
                }
                return point;
              });

              // The segment into index i is the stand-in's when i is listed: long-dashed without area.
              // Highcharts multiplies whole dash units by the line width, so 3,1 at width 3 draws 9/3.
              var standInDash = "3,1";
              var zones = [];
              for (var i = 1; i <= lastIndex; i++) {
                var dashed = standIn.indexOf(i) >= 0;
                var current = zones[zones.length - 1];
                if (!current || current.dashed !== dashed) {
                  if (current) current.value = i - 1;
                  zones.push({ dashed: dashed });
                }
              }
              zones = zones.map(function (zone) {
                return zone.dashed
                  ? { value: zone.value, dashStyle: standInDash, fillColor: "transparent" }
                  : { value: zone.value };
              });

              var label = TRMNLCharts.textStyle("chart-label", { el: el, stroke: "white" });
              TRMNLCharts.watch(el, function () {
                return Highcharts.chart(el, TRMNLCharts.merge(TRMNLCharts.options({ el: el }), {
                  chart: { type: "area", height: px(214), margin: [px(20), px(6), px(24), px(2)], animation: false },
                  series: [{
                    animation: false,
                    data: points,
                    threshold: null,
                    color: paint(live ? "black" : "gray-30"),
                    lineWidth: px(live ? 3 : 2),
                    fillColor: live ? paint("gray-55") : "transparent",
                    zoneAxis: "x",
                    zones: zones,
                    linecap: "butt",
                    clip: false,
                    dataLabels: { style: label, allowOverlap: true }
                  }],
                  yAxis: {
                    min: 400,
                    max: 1600,
                    tickPositions: [400, 1000, 1400, 1600],
                    gridLineWidth: 0,
                    title: { text: null },
                    labels: {
                      align: "left",
                      x: 0,
                      y: -px(5),
                      reserveSpace: false,
                      // Labels sit inside the plot, so the narrow space left of it must not ellipsize them.
                      style: TRMNLCharts.merge(label, { textOverflow: "clip", whiteSpace: "nowrap" }),
                      formatter: function () { return this.value === 1600 ? "1600 ppm" : String(this.value); }
                    },
                    plotLines: [1000, 1400].map(function (value) {
                      return { value: value, color: paint("gray-30"), width: px(2), dashStyle: "2,2", zIndex: 3 };
                    })
                  },
                  xAxis: {
                    min: 0,
                    max: lastIndex,
                    minPadding: 0,
                    maxPadding: 0,
                    tickPositions: hourTicks,
                    lineWidth: 0,
                    tickWidth: 0,
                    gridLineWidth: 0,
                    labels: { y: px(16), style: label, formatter: function () { return hourAt(this.value); } }
                  }
                }));
              });
            });
          </script>
        {%- endif -%}
      </div>

      {%- comment -%} Right: six values in a fixed 2 × 3 grid, or a note on what is missing {%- endcomment -%}
      {%- if fresh == false -%}
        <div class="flex flex--col flex--left flex--start gap--xsmall ra-detail">
          {%- unless stale -%}
            {%- if lead_off != "" -%}<span class="label label--large">{{ lead_off }}</span>{%- endif -%}
            {%- if stand_in_since -%}<span class="label label--large">SwitchBot: keine Daten seit {{ stand_in_since }}</span>{%- endif -%}
          {%- else -%}
            <span class="label label--large text--gray-30">Seit {{ last_push }} keine Übertragung</span>
          {%- endunless -%}
        </div>
      {%- else -%}
        <div class="ra-cells">
          {%- assign quantities = "pm2_5,pm10,voc,nox,temperature,humidity" | split: "," -%}
          {%- if lead_only_missing -%}
            {%- assign quantities = "temperature,humidity" | split: "," -%}
            <div class="ra-note">
              <span class="label label--large">{{ lead_off }}</span>
              <span class="label text--gray-30">CO2, Temperatur, Feuchte: SwitchBot</span>
              <span class="label text--gray-30">Feinstaub, VOC, NOx: erst wieder mit SEN66</span>
            </div>
          {%- endif -%}
          {%- for q in quantities -%}
            {%- assign v = values[q] -%}
            {%- assign lv = levels[q] -%}
            {%- assign position = forloop.index -%}
            {%- if lead_only_missing -%}{%- assign position = forloop.index | plus: 4 -%}{%- endif -%}
            {%- assign column = position | modulo: 2 -%}
            <div class="{% if position > 2 %}ra-rule{% if column == 1 %} ra-rule--bridge{% endif %}{% endif %}{% if lead_only_missing %} ra-row3{% endif %}">
              <div class="ra-head">
                <span class="label">
                  {%- case q -%}
                    {%- when "pm2_5" -%}PM2,5
                    {%- when "pm10" -%}PM10
                    {%- when "voc" -%}VOC-Index
                    {%- when "nox" -%}NOx-Index
                    {%- when "temperature" -%}Temperatur
                    {%- when "humidity" -%}Feuchte
                  {%- endcase -%}
                </span>
                {%- if v != nil and lv -%}
                  {%- capture word -%}
                    {%- case q -%}
                      {%- when "temperature" -%}
                        {%- if lv != "good" -%}{%- if v < 22 -%}zu kühl{%- else -%}zu warm{%- endif -%}{%- endif -%}
                      {%- when "humidity" -%}
                        {%- if lv != "good" -%}{%- if v < 50 -%}zu trocken{%- else -%}zu feucht{%- endif -%}{%- endif -%}
                      {%- when "voc", "nox" -%}
                        {%- case lv -%}{%- when "good" -%}normal{%- when "warn" -%}erhöht{%- else -%}hoch{%- endcase -%}
                      {%- else -%}
                        {%- case lv -%}{%- when "good" -%}gut{%- when "warn" -%}erhöht{%- else -%}hoch{%- endcase -%}
                    {%- endcase -%}
                  {%- endcapture -%}
                  {%- case lv -%}
                    {%- when "bad" -%}<span class="label ra-chip bg--black text--white">{{ word }}</span>
                    {%- when "warn" -%}<span class="label ra-chip bg--gray-30 text--white">{{ word }}</span>
                    {%- else -%}<span class="label text--gray-30">{{ word }}</span>
                  {%- endcase -%}
                {%- endif -%}
              </div>
              <div class="ra-base">
                {%- if v != nil -%}
                  <span class="value value--large value--tnums">{% if q == "temperature" %}{{ v | replace: ".", "," | replace: "-", "−" }}{% else %}{{ v | replace: ".", "," }}{% endif %}</span>
                  <span class="label text--gray-30">
                    {%- case q -%}{%- when "pm2_5", "pm10" -%}µg/m³{%- when "temperature" -%}°C{%- when "humidity" -%}%{%- endcase -%}
                  </span>
                {%- else -%}
                  <span class="value value--large">&#8203;</span>
                  <span class="value value--small text--gray-30">{% if starting and q == "voc" or starting and q == "nox" %}läuft an{% else %}keine Daten{% endif %}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Bottom: row 1 what to do (verdict, reason, hint), row 2 the data (balcony, push time) {%- endcomment -%}
    <div class="ra-foot">
      {%- capture hint_text -%}
        {%- if hint contains "cools" -%}kühlt{%- elsif hint contains "warms" -%}wärmt{%- endif -%}
        {%- if hint contains "cools" or hint contains "warms" -%}
          {%- if hint contains "dries" or hint contains "humidifies" -%}{{ " und " }}{%- endif -%}
        {%- endif -%}
        {%- if hint contains "dries" -%}trocknet{%- elsif hint contains "humidifies" -%}befeuchtet{%- endif -%}
      {%- endcapture -%}
      {%- if balcony == nil or stale -%}{%- assign hint_text = "" -%}{%- endif -%}
      <div class="ra-line ra-line--baseline">
        {%- if fresh -%}
          {%- capture names -%}
            {%- if verdict == "good" -%}
              {%- if values.co2 != nil -%}CO₂|{%- endif -%}
              {%- if values.pm2_5 != nil or values.pm10 != nil -%}Feinstaub|{%- endif -%}
              {%- if values.voc != nil -%}VOC|{%- endif -%}
              {%- if values.nox != nil -%}NOx|{%- endif -%}
            {%- else -%}
              {%- if verdict_because contains "co2" -%}CO₂|{%- endif -%}
              {%- if verdict_because contains "pm2_5" or verdict_because contains "pm10" -%}Feinstaub|{%- endif -%}
              {%- if verdict_because contains "voc" -%}VOC|{%- endif -%}
              {%- if verdict_because contains "nox" -%}NOx|{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- assign names = names | split: "|" -%}
          {%- capture reason -%}
            {%- if names.size < 4 -%}
              {%- for n in names -%}
                {%- if forloop.index > 1 -%}{%- if forloop.last -%}{{ " und " }}{%- else -%}{{ ", " }}{%- endif -%}{%- endif -%}{{ n }}
              {%- endfor -%}
            {%- elsif names.size < 13 -%}
              {{- "Null,Ein,Zwei,Drei,Vier,Fünf,Sechs,Sieben,Acht,Neun,Zehn,Elf,Zwölf" | split: "," | slice: names.size | first }} Werte
            {%- else -%}
              {{- names.size }} Werte
            {%- endif -%}
          {%- endcapture -%}
          {%- capture verdict_text -%}
            {%- case verdict -%}
              {%- when "bad" -%}{{ reason }} hoch
              {%- when "warn" -%}{{ reason }} erhöht
              {%- when "good" -%}{%- if names.size == 4 and values.pm2_5 != nil and values.pm10 != nil -%}Luft gut{%- else -%}{{ reason }} gut{%- endif -%}
            {%- endcase -%}
          {%- endcapture -%}
          {%- comment -%} Width estimate in px: chip 150, separator 40, reason and hint 14 per character.
            With warn/bad the hint gives way if the row would not fit; the reason is never cut. {%- endcomment -%}
          {%- if hint_text != "" and verdict != "good" -%}
            {%- assign hint_width = hint_text | size | plus: 7 | times: 14 -%}
            {%- assign row_width = verdict_text | size | times: 14 | plus: 206 | plus: hint_width -%}
            {%- if row_width > 780 -%}{%- assign hint_text = "" -%}{%- endif -%}
          {%- endif -%}
          {%- case verdict -%}
            {%- when "bad" -%}<span class="value value--small ra-chip--line ra-keep bg--black text--white">Jetzt lüften</span>
            {%- when "warn" -%}<span class="value value--small ra-chip--line ra-keep bg--gray-30 text--white">Bald lüften</span>
          {%- endcase -%}
          {%- if reason != "" or verdict == "good" -%}<span class="value value--small ra-keep">{{ verdict_text }}</span>{%- endif -%}
          {%- if hint_text != "" -%}
            <span class="value value--small text--gray-30 ra-keep">·</span>
            <span class="value value--small ra-fit">Lüften {{ hint_text }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="value value--small text--gray-30">Keine Lüftungsempfehlung</span>
        {%- endif -%}
      </div>
      <div class="ra-line ra-line--split">
        <span class="label label--large text--gray-30 ra-fit">
          {%- if balcony and stale == false -%}
            {{- "Balkon " -}}{{ balcony.temperature | replace: ".", "," | replace: "-", "−" }} °C · 
            {{- " " }}{{ balcony.humidity }} %
            {%- if values.temperature != nil and balcony.humidity_indoors != nil -%}
              {%- if hint_text contains "trocknet" or hint_text contains "befeuchtet" -%}
                {{- " · bei " }}{{ values.temperature | replace: ".", "," | replace: "-", "−" }} °C: {{ balcony.humidity_indoors }} %
              {%- endif -%}
            {%- endif -%}
          {%- else -%}
            Balkon: keine Daten
          {%- endif -%}
        </span>
        <span class="label label--large value--tnums ra-keep{% unless stale %} text--gray-30{% endunless %}">Stand {{ last_push }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Raumluft</span>
  <span class="instance">{{ room }}{% if fresh %} · {% if source == "switchbot" %}SwitchBot{% else %}SEN66{% endif %}{% endif %}</span>
</div>
