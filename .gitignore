# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Mix and Phoenix build output.
/_build/
/deps/
/cover/
/doc/
/.fetch
erl_crash.dump
*.ez
/ziwoas-*.tar

# esbuild bundles assets/ into priv/static/assets; phx.digest writes the digested copies
# and the manifest.
/priv/static/assets/
/priv/static/cache_manifest.json

# The test database (migrated by `mix test`), logs and environment files.
/tmp/
/log/
/.env*

# The device config and the databases, at the defaults of config/runtime.exs.
/config/ziwoas.yml
/storage/*
!/storage/.keep
/data/*.db
/data/*.db-*
.legacy_backup/

.idea
/.worktrees/

# Left over from the Rails app.
/coverage/
/.mutant/
