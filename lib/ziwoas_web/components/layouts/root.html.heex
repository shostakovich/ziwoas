<!DOCTYPE html>
<html lang="de">
  <head>
    <title>{assigns[:page_title] || "Ziwoas"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <.theme_meta />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Ziwoas" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="ziwoas-time-zone" content={time_zone()} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.theme_script />

    <link rel="icon" href={~p"/images/favicon.png"} sizes="64x64" type="image/png" />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/setzkasten/fonts/Figtree-Variable.woff2"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
