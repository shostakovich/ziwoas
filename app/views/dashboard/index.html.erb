<% content_for :title, "Dashboard" %>
<% content_for :body_class, "page-dashboard" %>
<h1>Dashboard</h1>

<%= turbo_stream_from DashboardBroadcaster::STREAM %>

<div data-controller="live-freshness"
     data-live-freshness-threshold-s-value="<%= Plugs::Measurement::OFFLINE_AFTER_S %>">
  <%= render Dashboard::HeroComponent.new(live: @live,
                                          weather_asset: @weather_asset,
                                          weather_alt: @weather_alt) %>

  <div class="tiles">
    <%= render Dashboard::TileComponent.produced(@summary) %>
    <%= render Dashboard::TileComponent.consumed(@summary) %>
    <%= render Dashboard::TileComponent.savings(@summary) %>
    <%= render Dashboard::TileComponent.net_today(@summary) %>
    <%= render Dashboard::TileComponent.consumption_now(@live) %>
    <%= render Dashboard::TileComponent.netbalance_now(@live) %>
    <%= render Dashboard::TileComponent.autarky(@summary) %>
    <%= render Dashboard::TileComponent.self_consumption(@summary) %>
  </div>

  <%= render CardComponent.new(title: "Energiefluss", classes: "energy-flow-card",
                               data: { controller: "energy-flow" }) do %>
    <%= render Dashboard::EnergyFlowStateComponent.new(live: @live) %>
    <%= render "shared/energy_flow",
               pv_asset: @weather_asset,
               pv_alt: @weather_alt,
               battery_asset: ApplicationHelper::DEFAULT_BATTERY_ASSET %>
  <% end %>

  <h2 class="section-label">Steckdosen</h2>
  <%= render Dashboard::PlugBarComponent.new(live: @live) %>

  <div data-controller="today-chart">
    <%= render Dashboard::PlugDeltasComponent.new(deltas: []) %>

    <%= render CardComponent.new(title: "Gesamtenergie", subtitle: "Letzte 24 h") do %>
      <div class="chart-frame">
        <canvas data-today-chart-target="energyCanvas"></canvas>
      </div>
    <% end %>

    <%= render CardComponent.new(title: "Leistung", subtitle: "Letzte 24 h") do %>
      <div class="chart-frame">
        <canvas data-today-chart-target="powerCanvas"></canvas>
      </div>
    <% end %>
  </div>

  <div data-controller="history-chart">
    <%= render CardComponent.new(title: "Ertrag", subtitle: "Letzte 14 Tage") do %>
      <div class="chart-frame">
        <canvas data-history-chart-target="canvas"></canvas>
      </div>
    <% end %>
  </div>
</div>
