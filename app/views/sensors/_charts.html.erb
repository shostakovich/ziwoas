<% subtitle = ->(unit, charted) { [ unit, (charted.sole.name if charted.one?), "letzte 24 h" ].compact.join(" · ") } %>
<% co2_sensors = sensors.select { |s| s.type == :meter_pro_co2 } %>
<div data-controller="sensors-chart"
     data-sensors-chart-url-value="<%= sensors_series_path %>">
  <%= render CardComponent.new(title: "CO₂", subtitle: subtitle.call("ppm", co2_sensors)) do %>
    <div class="chart-frame chart-frame-prominent">
      <canvas data-sensors-chart-target="co2"></canvas>
    </div>
  <% end %>

  <div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
      <%= render CardComponent.new(title: "Temperatur", subtitle: subtitle.call("°C", sensors)) do %>
        <div class="chart-frame chart-frame-compact">
          <canvas data-sensors-chart-target="temperature"></canvas>
        </div>
      <% end %>
    </div>

    <div class="col">
      <%= render CardComponent.new(title: "Luftfeuchtigkeit", subtitle: subtitle.call("Prozent", sensors)) do %>
        <div class="chart-frame chart-frame-compact">
          <canvas data-sensors-chart-target="humidity"></canvas>
        </div>
      <% end %>
    </div>
  </div>
</div>
