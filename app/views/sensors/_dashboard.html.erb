<%= turbo_frame_tag "sensors_dashboard" do %>
  <% if latest.empty? %>
    <%= render CardComponent.new(title: "Noch keine Sensordaten") do %>
      <p>Die Sensoransicht erscheint, sobald die SwitchBot-API Daten geliefert hat.</p>
    <% end %>
  <% else %>
    <%= render "sensors/battery_warning", sensors: sensors, latest: latest %>
    <section class="row row-cols-1 row-cols-sm-<%= sensors.size.clamp(1, 2) %> row-cols-lg-<%= sensors.size.clamp(1, 3) %> g-3 mb-3" aria-label="Sensoren">
      <% sensors.each do |s| %>
        <div class="col"><%= render "sensors/card", sensor: s, reading: latest[s.id] %></div>
      <% end %>
    </section>
    <%= render "sensors/charts", sensors: sensors %>
  <% end %>
<% end %>
