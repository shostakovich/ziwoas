<%= turbo_frame_tag "weather_today" do %>
  <% if today_weather.any? %>
    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Heute</h2>
    <section class="weather-hour-row card card-body flex-row gap-3 overflow-x-auto mb-3" aria-label="Heute">
      <% today_weather.each do |record| %>
        <%= render "weather/hour_card", record: record %>
      <% end %>
    </section>
  <% end %>
<% end %>
