<%= turbo_frame_tag "weather_today" do %>
  <% if today_weather.any? %>
    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Heute</h2>
    <section class="weather-hour-row card mb-3" aria-label="Heute">
      <% rows = weather_hour_rows(today_weather) %>
      <% units = weather_hour_units(today_weather) %>
      <%# A key below takes over the card body's bottom padding. %>
      <div class="weather-hour-scroller card-body overflow-x-auto<%= ' pb-2' if units.any? %>">
        <% today_weather.each do |record| %>
          <%= render "weather/hour_card", record: record, rows: rows %>
        <% end %>
      </div>
      <%= render "weather/hour_key", units: units, classes: "px-4 pb-4" %>
    </section>
  <% end %>
<% end %>
