<%# locals: (rows:, classes:) -%>
<%# The units the hour cards leave out, named once for the whole strip. %>
<% units = { wind: "Wind in km/h", solar: "Sonne in W/m²" }.slice(*rows).values %>
<% if units.any? %>
  <p class="weather-hour-key small text-body-secondary mb-0 <%= classes %>"><%= units.join(" · ") %></p>
<% end %>
