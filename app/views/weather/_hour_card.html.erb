<%
  wind = record.wind_speed
  windy = wind && wind >= 20
  precip_mm = record.precipitation if record.precipitation&.positive?
  precip_prob = record.precipitation_probability if record.precipitation_probability && record.precipitation_probability >= 30
%>
<%# Every card fills the same three rows — sun, wind, rain — with a dash where
    there is nothing to tell, so the row of cards has no ragged empty band. %>
<article class="weather-hour-card flex-shrink-0 text-center small">
  <div class="weather-hour-time fw-semibold tabular-nums"><%= record.timestamp.strftime("%H:%M") %></div>
  <%= image_tag record.asset_name, class: "weather-icon weather-icon-sm d-block mx-auto my-2", width: 42, height: 42, loading: "lazy", alt: weather_icon_label(record.icon) %>
  <strong class="d-block fs-4 tabular-nums"><%= de_number(record.temperature) %>°</strong>
  <ul class="weather-hour-extras list-unstyled mt-1 mb-0 text-body-secondary tabular-nums text-nowrap">
    <% if record.daytime != "night" %>
      <li class="weather-hour-solar fw-semibold text-warning-emphasis">
        <%= image_tag "weather_clear_day.webp", class: "weather-icon-inline", alt: "" %>
        <%= record.solar_w_per_m2 ? de_number(record.solar_w_per_m2) : "—" %> W/m²
      </li>
    <% else %>
      <li class="text-body-tertiary" aria-hidden="true">–</li>
    <% end %>
    <% if wind %>
      <li class="weather-hour-wind<%= ' fw-semibold text-body' if windy %>">
        <%= image_tag "weather_wind_day.webp", class: "weather-icon-inline", alt: "Wind" %>
        <%= de_number(wind) %> km/h
      </li>
    <% else %>
      <li class="text-body-tertiary" aria-hidden="true">–</li>
    <% end %>
    <% if precip_mm || precip_prob %>
      <li class="weather-hour-rain">
        <%= image_tag "weather_rain_day.webp", class: "weather-icon-inline", alt: precip_mm ? "Regen" : "Regenwahrscheinlichkeit" %>
        <%= precip_mm ? "#{de_number(precip_mm, precision: 1)} mm" : "#{precip_prob} %" %>
      </li>
    <% else %>
      <li class="text-body-tertiary" aria-hidden="true">–</li>
    <% end %>
  </ul>
</article>
