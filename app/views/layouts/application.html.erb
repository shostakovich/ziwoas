<!DOCTYPE html>
<html lang="de" <%= tag.attributes(data: { look: ("felt" if current_look == "felt") }) %>>
  <head>
    <title><%= content_for(:title) || "Ziwoas" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <% theme_colors = Look.theme_colors(current_look) %>
    <meta name="theme-color" content="<%= theme_colors[:light] %>" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="<%= theme_colors[:dark] %>" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ziwoas">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="ziwoas-time-zone" content="<%= Time.zone.tzinfo.identifier %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# felt-css first: our stylesheets (all of app/assets/stylesheets, application.css first) build on it. %>
    <link rel="stylesheet" href="https://felt-css.rocu.de/felt.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <a class="visually-hidden-focusable btn btn-primary m-2" href="#main">Zum Inhalt springen</a>

    <div class="container pt-3">
      <header class="navbar navbar-expand px-3 app-header mb-3">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center py-0" do %>
          <picture>
            <source srcset="<%= image_path "logo-dark.webp" %>" media="(prefers-color-scheme: dark)">
            <%= image_tag "logo.webp", alt: "Ziwoas — Startseite", class: "app-logo", width: 172, height: 64 %>
          </picture>
        <% end %>
        <nav class="d-none d-lg-block me-auto" aria-label="Hauptnavigation">
          <ul class="navbar-nav nav-pills flex-nowrap">
            <% main_navigation.each do |item| %>
              <li class="nav-item">
                <%= link_to item.path, class: [ "nav-link d-flex align-items-center gap-2 px-2", ("active" if item.current) ],
                                       aria: { current: ("page" if item.current) } do %>
                  <%= image_tag item.icon, alt: "", class: "app-nav-icon", aria: { hidden: true } %>
                  <%= item.label %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
        <div class="d-flex align-items-center ms-auto">
          <%= render "layouts/look_toggle" %>
        </div>
      </header>
    </div>

    <main class="container app-main" id="main">
      <%= yield %>
    </main>

    <nav class="navbar fixed-bottom pb-safe d-lg-none" aria-label="Tab-Leiste">
      <ul class="nav nav-pills nav-fill w-100">
        <% main_navigation.each do |item| %>
          <li class="nav-item">
            <%= link_to item.path, class: [ "nav-link d-flex flex-column align-items-center", ("active" if item.current) ],
                                   aria: { current: ("page" if item.current) } do %>
              <%= image_tag item.icon, alt: "", class: "app-nav-icon", aria: { hidden: true } %>
              <small><%= item.label %></small>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  </body>
</html>
