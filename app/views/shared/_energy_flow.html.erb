<% target = ->(name) { "data-ef=\"#{name}\"".html_safe } %>
<% channels = EnergyFlowHelper::CHANNELS %>
<div class="energy-flow">
  <svg viewBox="0 0 <%= EnergyFlowHelper::WIDTH %> <%= EnergyFlowHelper::HEIGHT %>" class="d-block w-100 h-auto">
    <defs>
      <clipPath id="ef-clip">
        <path fill-rule="evenodd" d="<%= energy_flow_clip_path %>"/>
      </clipPath>
    </defs>

    <g fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" clip-path="url(#ef-clip)">
      <% channels.each do |channel| %>
        <path <%= target.call("efLine#{channel.key}") %> class="ef-link" style="--ef-tone: var(<%= channel.tone %>)" d="<%= channel.d %>"/>
      <% end %>
    </g>

    <g clip-path="url(#ef-clip)">
      <% channels.each do |channel| %>
        <g <%= target.call("efDots#{channel.key}") %> style="fill: var(<%= channel.tone %>)"></g>
      <% end %>
    </g>

    <g stroke-width="3" fill="none">
      <% EnergyFlowHelper::RINGS.each do |name, ring| %>
        <circle data-ring="<%= name %>" cx="<%= ring.cx %>" cy="<%= ring.cy %>" r="<%= EnergyFlowHelper::RADIUS %>" style="stroke: var(<%= ring.stroke %>)"/>
      <% end %>
    </g>
    <% consumer = EnergyFlowHelper::RINGS.fetch(:consumer) %>
    <g <%= target.call("efConsumerRing") %> transform="rotate(-90 <%= consumer.cx %> <%= consumer.cy %>)" fill="none" stroke-linecap="butt"></g>

    <g class="ef-names" text-anchor="middle" font-size="11" style="fill: var(--muted)">
      <text x="200" y="22">PV-Anlage</text>
      <text <%= target.call("efGridName") %> x="58" y="224">Stromnetz</text>
      <text x="342" y="224">Verbraucher</text>
      <text x="200" y="315"><tspan <%= target.call("efBatteryName") %>>Batterie</tspan><tspan <%= target.call("efBatterySoc") %>></tspan></text>
    </g>
  </svg>

  <%= energy_flow_ring :pv do %>
    <%= image_tag pv_asset, class: "ef-icon", alt: pv_alt %>
    <span class="ef-value fw-semibold tabular-nums lh-1" data-ef="efPvW">— W</span>
  <% end %>
  <%= energy_flow_ring :grid do %>
    <%= image_tag "icon_netz.webp", class: "ef-icon", alt: "" %>
    <span class="ef-value fw-semibold tabular-nums lh-1" data-ef="efGridW">— W</span>
  <% end %>
  <%= energy_flow_ring :consumer do %>
    <%= image_tag "icon_haus.webp", class: "ef-icon", alt: "" %>
    <span class="ef-value fw-semibold tabular-nums lh-1" data-ef="efConsumerW">— W</span>
  <% end %>
  <%= energy_flow_ring :battery do %>
    <%= image_tag battery_asset, class: "ef-icon", alt: "",
                                 data: { ef: "efBatteryImage",
                                         **ApplicationHelper::BATTERY_ASSETS
                                           .transform_keys { |state| "battery_state_#{state}" }
                                           .transform_values { |asset| asset_path(asset) } } %>
    <span class="ef-value fw-semibold tabular-nums lh-1" data-ef="efBatteryW">— W</span>
  <% end %>
</div>
<p class="energy-flow-key text-body-secondary text-center mt-2 mb-0">Verbraucher-Ring: Herkunft des Stroms</p>
