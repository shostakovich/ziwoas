<%# Streamed into #light_settings; opens itself as a modal and removes itself
    once closed (close button, Abbrechen, Esc or a click on the backdrop). %>
<dialog class="modal" closedby="any" aria-labelledby="light_settings_title"
        data-controller="settings-dialog"
        data-action="close->settings-dialog#remove click->settings-dialog#backdrop">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="light_settings_title">Einstellungen</h1>
        <button type="button" class="btn-close" aria-label="Schließen" data-action="settings-dialog#close"></button>
      </div>
      <div class="modal-body">
        <%= render "form", light: light, plugs: plugs %>
      </div>
    </div>
  </div>
</dialog>
