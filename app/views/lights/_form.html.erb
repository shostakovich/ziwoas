<%= form_with model: light do |f| %>
  <% if light.errors.any? %>
    <div class="alert alert-danger small py-2" role="alert">
      <ul class="mb-0 ps-3">
        <% light.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-4">
    <%= f.label :shelly_plug_id, "Shelly-Plug", class: "form-label" %>
    <%= f.select :shelly_plug_id,
          options_for_select(plugs.map { |p| [ p.name, p.id ] }, light.shelly_plug_id),
          { include_blank: "— keine —" },
          { class: "form-select" } %>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%# Inside the settings dialog Abbrechen just closes it; on the plain edit
        page it leads back to the lamp. %>
    <%= link_to "Abbrechen", light_path(light.key), class: "btn btn-outline-secondary",
                data: { action: "settings-dialog#close" } %>
    <%= f.submit "Speichern", class: "btn btn-primary" %>
  </div>
<% end %>
