<% content_for :title, @light.name %>

<div data-controller="light-detail"
     data-light-detail-key-value="<%= @light.key %>"
     data-light-detail-tab-value="white">

  <%= turbo_stream_from "light_#{@light.key}" %>

  <div class="d-flex align-items-center gap-2 mb-3">
    <%= link_to "←", switches_path, class: "btn btn-icon btn-light flex-shrink-0", "aria-label": "Zurück" %>
    <h1 class="ld-title h2 mb-0 me-auto"><%= @light.name %></h1>
    <%= link_to edit_light_path(@light.key), class: "btn btn-icon flex-shrink-0",
                data: { turbo_stream: true }, "aria-label": "Einstellungen" do %>
      <%= image_tag "settings_plush.webp", width: 28, height: 28, alt: "", aria: { hidden: true } %>
    <% end %>
  </div>

  <%= render Lights::PowerComponent.new(snapshot: @snapshot) %>

  <div class="card mb-3">
    <div class="card-body">
      <label class="d-block mb-2 small text-uppercase text-body-secondary" for="light_brightness">Helligkeit</label>
      <input class="form-range" type="range" id="light_brightness" min="1" max="100"
             value="<%= [ @snapshot.brightness, 1 ].max %>"
             data-light-detail-target="range" data-action="light-detail#brightness">
    </div>
  </div>

  <div class="nav nav-pills nav-fill mb-3" role="tablist" aria-label="Lichtart">
    <% tabs = { "white" => "Weiß", "color" => ("Farbe" if @light.supports_color), "scenes" => "Szenen" }.compact %>
    <% tabs.each do |key, label| %>
      <button type="button" class="nav-link" role="tab" id="light_tab_<%= key %>"
              aria-controls="light_panel_<%= key %>" aria-selected="false"
              data-light-detail-target="tab" data-action="light-detail#tab"
              data-light-detail-tab-param="<%= key %>"><%= label %></button>
    <% end %>
  </div>

  <%= render Lights::WhitePanelComponent.new(snapshot: @snapshot) %>

  <% if @light.supports_color %>
    <%= render Lights::ColorPanelComponent.new(snapshot: @snapshot) %>
  <% end %>

  <%= render Lights::ScenesComponent.new(light: @light) %>

  <div class="toast-container ld-toast-container">
    <%= render Lights::ToastComponent.new(message: nil, undo: nil) %>
  </div>

  <%# The settings dialog is streamed in here. %>
  <div id="light_settings"></div>

</div>
