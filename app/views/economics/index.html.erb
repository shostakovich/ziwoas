<% content_for :title, "Wirtschaftlichkeit" %>
<% euro = ->(value, precision = 2) { de_number(value, precision: precision) } %>
<% day = ->(date) { l(date, format: "%d.%m.%Y") } %>

<h1 class="h2 mb-3">Wirtschaftlichkeit</h1>

<%= render Economics::OverviewCardComponent.new(result: @overview, title: "Stand", link: false) %>

<%= render CardComponent.new(title: "Kostenposten") do %>
  <p class="small text-body-secondary">
    Alles, was die Anlage gekostet hat. Eine Förderung oder Rückerstattung wird
    als negativer Betrag erfasst.
  </p>

  <% if @cost_items.any? %>
    <ul class="list-group list-group-flush mb-2">
      <% @cost_items.each do |item| %>
        <li class="list-group-item economics-row d-flex align-items-center gap-3 px-0">
          <div class="me-auto">
            <div><%= item.label %></div>
            <div class="small text-body-secondary tabular-nums">
              <%= day.call(item.date) %><% if item.note.present? %> · <%= item.note %><% end %>
            </div>
          </div>
          <span class="fw-semibold tabular-nums text-nowrap"><%= euro.call(item.amount_eur) %> €</span>
          <%= button_to "", cost_item_path(item), method: :delete, class: "btn-close",
                        title: "Löschen", aria: { label: "#{item.label} löschen" },
                        form: { data: { turbo_confirm: "#{item.label} wirklich löschen?" } } %>
        </li>
      <% end %>
    </ul>
    <p class="d-flex justify-content-between">
      Summe <strong class="tabular-nums"><%= euro.call(@overview.acquisition_cost_eur) %> €</strong>
    </p>
  <% else %>
    <p class="small text-body-secondary">Noch keine Kostenposten erfasst.</p>
  <% end %>

  <%= form_with url: cost_items_path, method: :post, scope: :cost_item, class: "row g-2" do |f| %>
    <% if @cost_errors.present? %>
      <div class="col-12"><div class="alert alert-danger mb-0" role="alert"><%= @cost_errors.join(", ") %></div></div>
    <% end %>
    <div class="col-12 col-md-6">
      <%= f.label :label, "Bezeichnung", class: "form-label small mb-1" %>
      <%= f.text_field :label, class: "form-control" %>
    </div>
    <div class="col-6 col-md-3">
      <%= f.label :amount_eur, "Betrag in €", class: "form-label small mb-1" %>
      <%= f.text_field :amount_eur, inputmode: "decimal", class: "form-control" %>
    </div>
    <div class="col-6 col-md-3">
      <%= f.label :spent_on, "Datum", class: "form-label small mb-1" %>
      <%= f.date_field :spent_on, value: Date.current, class: "form-control" %>
    </div>
    <div class="col-12">
      <%= f.label :note, "Notiz (optional)", class: "form-label small mb-1" %>
      <%= f.text_field :note, class: "form-control" %>
    </div>
    <div class="col-12">
      <%= f.submit "Hinzufügen", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new(title: "Strompreise") do %>
  <p class="small text-body-secondary">
    Was eine Kilowattstunde aus dem Netz kostet. Ein Preis gilt ab seinem Datum
    bis zum nächsten; der früheste deckt auch alle Tage davor.
  </p>

  <% if @prices.any? %>
    <ul class="list-group list-group-flush mb-3">
      <% @prices.each do |price| %>
        <li class="list-group-item economics-row d-flex align-items-center gap-3 px-0">
          <span class="me-auto tabular-nums">ab <%= day.call(price.date) %></span>
          <span class="fw-semibold tabular-nums text-nowrap"><%= euro.call(price.eur_per_kwh, 4) %> €/kWh</span>
          <%= button_to "", electricity_price_path(price), method: :delete, class: "btn-close",
                        title: "Löschen", aria: { label: "Preis ab #{day.call(price.date)} löschen" },
                        form: { data: { turbo_confirm: "Preis ab #{day.call(price.date)} wirklich löschen?" } } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="small text-body-secondary">Noch kein Strompreis erfasst. Ohne ihn bleibt die Ersparnis unbekannt.</p>
  <% end %>

  <%= form_with url: electricity_prices_path, method: :post, scope: :electricity_price, class: "row g-2 align-items-end" do |f| %>
    <% if @price_errors.present? %>
      <div class="col-12"><div class="alert alert-danger mb-0" role="alert"><%= @price_errors.join(", ") %></div></div>
    <% end %>
    <div class="col-6 col-md-4">
      <%= f.label :eur_per_kwh, "Preis in €/kWh", class: "form-label small mb-1" %>
      <%= f.text_field :eur_per_kwh, inputmode: "decimal", class: "form-control" %>
    </div>
    <div class="col-6 col-md-4">
      <%= f.label :valid_from, "Gültig ab", class: "form-label small mb-1" %>
      <%= f.date_field :valid_from, value: Date.current, class: "form-control" %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.submit "Hinzufügen", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= link_to "Zurück zu PV", solakon_path, class: "btn btn-outline-secondary" %>
