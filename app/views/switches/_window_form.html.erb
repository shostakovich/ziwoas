<%# A persisted window takes the id of its row, so the form can replace it and
    be replaced by it again. %>
<%= tag.div id: (form.persisted? ? "sw_entry_#{plug.id}_#{form.group_id}" : nil) do %>
  <%= form_with url: (form.persisted? ? switch_window_path(plug_id: plug.id, group_id: form.group_id)
                                      : switch_windows_path(plug_id: plug.id)),
                method: (form.persisted? ? :patch : :post),
                scope: :switch_window, class: "bg-body border rounded p-2 p-sm-3 mt-2 vstack gap-3" do |f| %>
    <% if form.errors.any? %>
      <div class="small text-danger-emphasis"><%= form.errors.join(", ") %></div>
    <% end %>
    <div class="d-flex align-items-center gap-2">
      <%= f.time_field :on_at_time, value: form.on_at_time, class: "form-control form-control-sm tabular-nums",
                       "aria-label": "Einschalten um" %>
      <span class="small text-body-secondary">bis</span>
      <%= f.time_field :off_at_time, value: form.off_at_time, class: "form-control form-control-sm tabular-nums",
                       "aria-label": "Ausschalten um" %>
    </div>
    <%= render "switches/weekdays", scope: :switch_window, days: form.days,
                                    id_prefix: "sw_day_#{plug.id}_#{form.group_id || 'new'}" %>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <%= f.submit "Speichern", class: "btn btn-sm btn-primary" %>
      <%= link_to "Abbrechen", switches_path, class: "btn btn-sm btn-outline-secondary" %>
      <span class="small text-body-secondary">Über Mitternacht? Einfach 22:00–06:00 eintragen.</span>
    </div>
  <% end %>
<% end %>
