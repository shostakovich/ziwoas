<%# The hint spells out what the missing partner means, so that "bleibt aus"
    reads as a decision rather than an omission. %>
<%= tag.div id: (form.persisted? ? "sw_entry_#{plug.id}_#{form.id}" : nil) do %>
  <%= form_with url: (form.persisted? ? switch_rule_path(plug_id: plug.id, id: form.id)
                                      : switch_rules_path(plug_id: plug.id)),
                method: (form.persisted? ? :patch : :post),
                scope: :switch_rule, class: "bg-body border rounded p-2 p-sm-3 mt-2 vstack gap-3" do |f| %>
    <% if form.errors.any? %>
      <div class="small text-danger-emphasis"><%= form.errors.join(", ") %></div>
    <% end %>
    <% id_prefix = "sw_#{plug.id}_#{form.id || 'new'}" %>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <%= f.time_field :at_minute_time, value: form.at_minute_time, class: "form-control form-control-sm tabular-nums",
                       "aria-label": "Uhrzeit" %>
      <%# Radios, not a checkbox: the direction can never end up neither. %>
      <div class="btn-group btn-group-sm" role="group" aria-label="Richtung">
        <% { "on" => "an", "off" => "aus" }.each do |value, label| %>
          <%= f.radio_button :action, value, checked: form.action == value,
                             id: "#{id_prefix}_action_#{value}", class: "btn-check", autocomplete: "off" %>
          <label class="btn btn-outline-primary" for="<%= id_prefix %>_action_<%= value %>"><%= label %></label>
        <% end %>
      </div>
    </div>
    <%= render "switches/weekdays", scope: :switch_rule, days: form.days, id_prefix: "sw_day_#{plug.id}_#{form.id || 'new'}" %>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <%= f.submit "Speichern", class: "btn btn-sm btn-primary" %>
      <%= link_to "Abbrechen", switches_path, class: "btn btn-sm btn-outline-secondary" %>
      <span class="small text-body-secondary">Bleibt aus, bis etwas anderes einschaltet.</span>
    </div>
  <% end %>
<% end %>
