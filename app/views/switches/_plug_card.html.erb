<div class="sw-card sw-plug-card<%= ' sw-offline' if row.offline? %>" id="sw_card_<%= row.plug.id %>" data-plug-id="<%= row.plug.id %>">
  <%= render "switches/head", row: row %>
  <details class="sw-details">
    <%= render "switches/summary", row: row %>
    <%= render "switches/entries", plug: row.plug, entries: row.entries %>
  </details>
</div>
