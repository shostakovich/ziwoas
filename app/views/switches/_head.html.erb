<div class="d-flex align-items-start gap-3" id="sw_head_<%= row.plug.id %>">
  <div class="flex-grow-1">
    <h3 class="card-title h5 mb-1"><%= row.plug.name %></h3>
    <div class="small text-body-secondary"><%= switch_status_line(row) %></div>
    <div class="small text-danger-emphasis" id="sw_error_<%= row.plug.id %>"></div>
  </div>
  <div class="d-flex flex-column align-items-end gap-2">
    <%= button_to "", plug_switch_path(plug_id: row.plug.id, state: row.on? ? "off" : "on"),
                  class: "sw-knob#{' off' if row.offline? || !row.on?}",
                  disabled: row.offline?,
                  aria: { label: "#{row.plug.name} #{row.on? ? 'ausschalten' : 'einschalten'}" } %>
    <% if row.on? && !row.offline? %>
      <span class="badge border tabular-nums">
        <span class="text-warning me-1" aria-hidden="true">⚡</span><%= "#{row.watt&.round || 0} W" %>
      </span>
    <% end %>
  </div>
</div>
