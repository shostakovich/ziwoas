<% content_for :title, "Schalten" %>
<h1 class="h2 mb-3">Schalten</h1>

<%= turbo_stream_from DashboardBroadcaster::STREAM %>

<div>
  <% if @rows.empty? %>
    <section class="card card-body mb-3">
      <h2 class="card-title h5">Keine schaltbaren Steckdosen</h2>
      <p class="text-body-secondary mb-0">Markiere Verbraucher in <code>ziwoas.yml</code> mit <code>switchable: true</code>.</p>
    </section>
  <% end %>

  <% if @light_snapshots.any? %>
    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Lampen</h2>
    <%= turbo_stream_from "lights" %>
    <% @light_snapshots.each do |snapshot| %>
      <%= render Lights::LightCardComponent.new(snapshot: snapshot) %>
    <% end %>
  <% end %>

  <% if @rows.any? %>
    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Steckdosen</h2>
  <% end %>
  <% @rows.each do |row| %>
    <%= render "switches/plug_card", row: row %>
  <% end %>
</div>
