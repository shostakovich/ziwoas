<% if rows.any? %>
  <% max_kwh = rows.map { |row| row.fetch(:kwh).to_f }.max.to_f %>
  <ol class="list-group mb-3 small" aria-label="Rangliste">
    <% rows.each_with_index do |row, index| %>
      <% share = max_kwh.positive? ? (row.fetch(:kwh).to_f / max_kwh * 100).round(1) : 0 %>
      <li class="list-group-item">
        <div class="row g-2 align-items-center">
          <span class="col-1 text-body-secondary tabular-nums"><%= index + 1 %></span>
          <span class="col-4 col-md-3 text-truncate"><%= row.fetch(:name) %></span>
          <span class="col">
            <span class="progress" style="height: .5rem" aria-hidden="true">
              <span class="progress-bar<%= " bg-warning" if row.fetch(:role) == "producer" %>" style="width: <%= share %>%"></span>
            </span>
          </span>
          <span class="col-3 col-md-2 text-end tabular-nums text-nowrap"><%= number_with_precision(row.fetch(:kwh), precision: 2, delimiter: ".", separator: ",") %> kWh</span>
        </div>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="small text-body-secondary">Keine Daten</p>
<% end %>
