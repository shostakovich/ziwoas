<% content_for :title, "Berichte" %>
<% content_for :body_class, "page-reports" %>
<h1 class="h3 fw-medium text-body-secondary mb-3">Berichte</h1>

<%
  daily_has_weather = @report.chart_payload.dig(:daily, :weather).present?
  detail_has_weather = @report.chart_payload.dig(:detail, :weather).present?
%>

<div data-controller="energy-report">
  <section class="card card-body mb-3 d-flex flex-column flex-sm-row flex-wrap align-items-stretch align-items-sm-end justify-content-between gap-3" aria-label="Zeitraum">
    <% custom = %w[last_7 last_30].exclude?(@report.preset) %>
    <div class="btn-group" role="group" aria-label="Schnellauswahl">
      <% { "last_7" => "Letzte 7 Tage", "last_30" => "Letzte 30 Tage" }.each do |preset, label| %>
        <% current = @report.preset == preset %>
        <%= link_to label, reports_path(preset: preset),
                    class: [ "btn btn-outline-secondary", ("active" if current) ],
                    aria: { current: ("page" if current) } %>
      <% end %>
      <% if custom %>
        <span class="btn btn-outline-secondary active" aria-current="true">Benutzerdefiniert</span>
      <% end %>
    </div>

    <%= form_with url: reports_path, method: :get, local: true, class: "row g-2 align-items-end" do %>
      <div class="col-6 col-sm-auto">
        <%= label_tag :start_date, "Von", class: "form-label small text-body-secondary mb-1" %>
        <%= date_field_tag :start_date, params[:start_date].presence || @report.start_date, max: @report.end_date, class: "form-control" %>
      </div>
      <div class="col-6 col-sm-auto">
        <%= label_tag :end_date, "Bis", class: "form-label small text-body-secondary mb-1" %>
        <%= date_field_tag :end_date, params[:end_date].presence || @report.end_date, min: @report.start_date, max: @report.end_date, class: "form-control" %>
      </div>
      <div class="col-12 col-sm-auto">
        <%= submit_tag "Anwenden", name: nil, class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </section>

  <% @report.messages.each do |message| %>
    <p class="alert alert-warning mb-3" role="status"><%= message %></p>
  <% end %>

  <% if @report.empty? %>
    <section class="card card-body mb-3 empty-state">
      <h2 class="card-title">Noch keine Berichtsdaten</h2>
      <p class="mb-0">Die Rückschau erscheint, sobald die erste Tagesaggregation vorhanden ist.</p>
    </section>
  <% else %>
    <% kwh = ->(key) { "#{number_with_precision(@report.summary.fetch(key), precision: 2, delimiter: ".", separator: ",")} kWh" } %>
    <% pct = ->(key) { "#{number_with_precision(@report.summary.fetch(key) * 100, precision: 1, delimiter: ".", separator: ",")} %" } %>
    <% savings = @report.summary.fetch(:savings_eur) %>
    <section class="row row-cols-2 row-cols-md-4 g-2 mb-3" aria-label="Zusammenfassung">
      <%= render Dashboard::TileComponent.new(label: "Ertrag", value: kwh.call(:produced_kwh)) %>
      <%= render Dashboard::TileComponent.new(label: "Verbrauch", value: kwh.call(:consumed_kwh)) %>
      <%= render Dashboard::TileComponent.new(label: "Gespart", value: savings.nil? ? "—" : "#{number_with_precision(savings, precision: 2, delimiter: ".", separator: ",")} €") %>
      <%= render Dashboard::TileComponent.new(label: "Bilanz", value: kwh.call(:balance_kwh)) %>
      <%= render Dashboard::TileComponent.new(label: "Autarkie", value: pct.call(:autarky_ratio)) %>
      <%= render Dashboard::TileComponent.new(label: "Eigenverbrauchsquote", value: pct.call(:self_consumption_ratio)) %>
      <%= render Dashboard::TileComponent.new(label: "Ø Ertrag/Tag", value: kwh.call(:avg_produced_kwh)) %>
      <%= render Dashboard::TileComponent.new(label: "Ø Verbrauch/Tag", value: kwh.call(:avg_consumed_kwh)) %>
    </section>

    <h2 class="h6 text-uppercase text-body-secondary mt-4 mb-2">Steckdosen</h2>
    <%= render "ranking", rows: @report.producer_ranking + @report.consumer_ranking %>

    <%= render CardComponent.new(title: "Energie", subtitle: "Ertrag / Verbrauch") do %>
      <% if daily_has_weather %>
        <div class="d-flex align-items-center mb-2">
          <div class="form-check form-switch mb-0">
            <input type="checkbox" class="form-check-input" role="switch" id="report-daily-weather"
                   data-energy-report-target="dailyWeatherCheckbox"
                   data-action="change->energy-report#toggleDailyWeather">
            <label class="form-check-label" for="report-daily-weather">Wetter & Solar</label>
          </div>
        </div>
      <% end %>
      <div class="chart-frame">
        <canvas data-energy-report-target="dailyCanvas"></canvas>
      </div>
    <% end %>

    <% power_resolution = (@report.detail_end_date - @report.detail_start_date).to_i > 6 ? "Tagesmittel" : "5-Minuten-Verlauf" %>
    <% detail_from = @report.detail_start_date.strftime("%d.%m.%Y") %>
    <% detail_to = @report.detail_end_date.strftime("%d.%m.%Y") %>
    <% detail_range = detail_from == detail_to ? detail_from : "#{detail_from} bis #{detail_to}" %>
    <%= render CardComponent.new(title: "Leistung", subtitle: "#{power_resolution} · #{detail_range}") do %>
      <% if detail_has_weather %>
        <div class="d-flex align-items-center mb-2">
          <div class="form-check form-switch mb-0">
            <input type="checkbox" class="form-check-input" role="switch" id="report-detail-weather"
                   data-energy-report-target="detailWeatherCheckbox"
                   data-action="change->energy-report#toggleDetailWeather">
            <label class="form-check-label" for="report-detail-weather">Wetter-Overlay</label>
          </div>
        </div>
      <% end %>
      <div class="chart-frame">
        <canvas data-energy-report-target="detailCanvas"></canvas>
      </div>
    <% end %>

    <%= render CardComponent.new(title: "Autarkie & Eigenverbrauchsquote") do %>
      <div class="chart-frame">
        <canvas data-energy-report-target="ratiosCanvas"></canvas>
      </div>
    <% end %>
  <% end %>

  <script type="application/json" data-energy-report-target="payload"><%= raw json_escape(@report.chart_payload.to_json) %></script>

  <%
    weather_assets = {}
    [ @report.chart_payload.dig(:daily, :weather, :icons),
      @report.chart_payload.dig(:detail, :weather, :icons) ].compact.flatten.each do |icon|
      next unless icon
      weather_assets[icon[:asset_name]] ||= asset_path(icon[:asset_name])
    end
  %>
  <% if weather_assets.any? %>
    <script type="application/json" data-energy-report-target="weatherAssets"><%= raw json_escape(weather_assets.to_json) %></script>
  <% end %>
</div>
