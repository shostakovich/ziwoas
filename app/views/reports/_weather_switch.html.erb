<div class="d-flex align-items-center mb-2">
  <div class="form-check form-switch mb-0">
    <input type="checkbox" class="form-check-input" role="switch" id="report-<%= chart %>-weather"
           data-energy-report-target="<%= chart %>WeatherCheckbox"
           data-action="change->energy-report#toggle<%= chart.capitalize %>Weather">
    <label class="form-check-label" for="report-<%= chart %>-weather">Wetter einblenden</label>
  </div>
</div>
