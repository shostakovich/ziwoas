<svg class="co2-gauge" viewBox="0 0 120 70" role="img" aria-label="<%= label %>">
  <defs>
    <pattern id="<%= dom_id("texture") %>" patternUnits="userSpaceOnUse" width="<%= TEXTURE_SIZE %>" height="<%= TEXTURE_SIZE %>">
      <image href="<%= FELT_TEXTURE %>" width="<%= TEXTURE_SIZE %>" height="<%= TEXTURE_SIZE %>"/>
    </pattern>
    <%# felt-css's stitch (img/seam-md.svg) %>
    <pattern id="<%= dom_id("thread") %>" width="1.25" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-58)">
      <rect width="1.25" height="4" fill="#fafafa"/><rect width=".5" height="4" fill="#e6e6e6"/>
    </pattern>
    <radialGradient id="<%= dom_id("hole") %>"><stop offset="0" stop-opacity=".16"/><stop offset="1" stop-opacity="0"/></radialGradient>
    <g id="<%= dom_id("stitch") %>">
      <circle cx="-3.2" r=".9" fill="url(#<%= dom_id("hole") %>)"/>
      <circle cx="3.2" r=".9" fill="url(#<%= dom_id("hole") %>)"/>
      <path d="M-3.5 0C-2.7 -.8 -1.9 -.8 -1.1 -.8H1.1C1.9 -.8 2.7 -.8 3.5 0C2.7 .8 1.9 .8 1.1 .8H-1.1C-1.9 .8 -2.7 .8 -3.5 0Z" fill="url(#<%= dom_id("thread") %>)"/>
      <rect x="-1.7" y="-.3" width="3.4" height=".34" rx=".17" fill="#fff" opacity=".7"/>
    </g>
    <%# The region spans the whole drawing: a stroked arc's bounding box leaves out half its width. %>
    <filter id="<%= dom_id("cut") %>" filterUnits="userSpaceOnUse" x="-5" y="-5" width="130" height="80" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="fibres"/>
      <feDisplacementMap in="SourceGraphic" in2="fibres" scale="1.6" xChannelSelector="R" yChannelSelector="G"/>
      <feDropShadow class="co2-gauge-shadow" dx="0" dy="1.2" stdDeviation="0.9"/>
    </filter>
  </defs>
  <g class="co2-gauge-piece" filter="url(#<%= dom_id("cut") %>)">
    <% zones.each do |level, path, current| %>
      <path class="co2-gauge-zone<%= ' is-current' if current %>" data-level="<%= level %>" d="<%= path %>"/>
      <path class="co2-gauge-texture" d="<%= path %>" stroke="url(#<%= dom_id("texture") %>)"/>
    <% end %>
  </g>
  <g class="co2-gauge-stitches">
    <% stitches.each do |transform| %>
      <use href="#<%= dom_id("stitch") %>" transform="<%= transform %>"/>
    <% end %>
  </g>
  <g class="co2-gauge-piece" filter="url(#<%= dom_id("cut") %>)">
    <g class="co2-gauge-needle" transform="rotate(<%= needle_angle %> <%= CENTER %> <%= CENTER %>)">
      <line x1="<%= CENTER %>" y1="<%= CENTER %>" x2="<%= CENTER - RADIUS + 8 %>" y2="<%= CENTER %>"/>
    </g>
    <circle class="co2-gauge-hub" cx="<%= CENTER %>" cy="<%= CENTER %>" r="6"/>
    <circle class="co2-gauge-texture" cx="<%= CENTER %>" cy="<%= CENTER %>" r="6" fill="url(#<%= dom_id("texture") %>)"/>
  </g>
  <g class="co2-gauge-stitches">
    <use href="#<%= dom_id("stitch") %>" transform="translate(<%= CENTER %> <%= CENTER %>) rotate(45) scale(0.8)"/>
    <use href="#<%= dom_id("stitch") %>" transform="translate(<%= CENTER %> <%= CENTER %>) rotate(-45) scale(0.8)"/>
  </g>
</svg>
