<div class="card mb-3" id="light_panel_scenes" role="tabpanel" aria-labelledby="light_tab_scenes"
     data-light-detail-target="panel" data-tab="scenes" hidden>
  <div class="card-body">
    <% if light.firmware_scenes.any? %>
      <p class="d-block mb-2 small text-uppercase text-body-secondary">Govee-Szenen</p>
      <div class="ld-scenes">
        <div class="row row-cols-2 g-2">
          <% light.firmware_scenes.each do |scene| %>
            <div class="col">
              <%= button_to light_command_path(light_key: light.key),
                    params: { command: "effect", effect: scene },
                    class: "btn btn-light d-flex flex-column align-items-stretch w-100 p-0 overflow-hidden" do %>
                <span class="ld-scene-preview" style="background-image: <%= scene_gradient(scene) %>"></span>
                <span class="small text-start text-truncate px-2 py-1"><%= scene %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="d-block mb-2 small text-uppercase text-body-secondary">Szenen</p>
      <p class="small text-body-secondary mb-0">Diese Lampe meldet keine Govee-Szenen.</p>
    <% end %>
  </div>
</div>
