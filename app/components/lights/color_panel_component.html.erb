<div class="card mb-3" id="light_panel_color" role="tabpanel" aria-labelledby="light_tab_color"
     data-light-detail-target="panel" data-tab="color" hidden>
  <div class="card-body">
    <p class="d-block mb-2 small text-uppercase text-body-secondary" id="light_color_label">
      <%= snapshot.zone_lamp? ? "Farbe · Welle + Seite" : "Farbe" %>
    </p>
    <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-labelledby="light_color_label">
      <% SWATCHES.each_with_index do |hex, i| %>
        <input type="radio" class="btn-check" name="light_color" id="light_color_<%= i %>" autocomplete="off"
               <%= "checked" if selected?(hex) %>
               data-action="light-detail#swatch" data-light-detail-color-param="<%= hex %>">
        <label class="btn btn-icon ld-swatch" for="light_color_<%= i %>" style="background-color: <%= hex %>">
          <span class="visually-hidden">Farbe <%= hex %></span>
        </label>
      <% end %>
      <label class="btn btn-icon ld-swatch ld-swatch-wheel" title="Weitere Farbe">
        <span class="visually-hidden">Weitere Farbe</span>
        <input type="color" data-action="light-detail#wheel" value="<%= snapshot.color_hex || '#ff7a3d' %>">
      </label>
    </div>
  </div>
</div>
