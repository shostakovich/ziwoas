<div id="light_power" class="card mb-3">
  <div class="card-body d-flex align-items-center gap-3">
    <%# The lamp's knob from the Schalten tab, larger and only for show: the buttons beside it switch. %>
    <span class="btn btn-light btn-icon sw-knob sw-lamp-knob sw-lamp-hero pe-none flex-shrink-0<%= ' off' unless snapshot.on? %>" aria-hidden="true">
      <%= image_tag "lamp_#{light.plush_type}_#{snapshot.on? ? 'on' : 'off'}.webp",
                    width: 112, height: 112, alt: "", class: "sw-knob-plush" %>
    </span>
    <%# The current choice is denim like every other selection; the warm tone belongs to the lamp's ring. %>
    <div class="vstack justify-content-center gap-2 ld-choices">
      <div class="d-flex gap-2" role="group" aria-label="Lampe">
        <% { "An" => true, "Aus" => false }.each do |label, on| %>
          <%= button_to label, light_command_path(light_key: light.key),
                params: { command: "turn", on: on.to_s },
                class: "btn btn-outline-primary w-100#{' active' if snapshot.on? == on}",
                form_class: "flex-fill", "aria-pressed": (snapshot.on? == on).to_s %>
        <% end %>
      </div>
      <% if snapshot.zone_lamp? %>
        <%# Zones belong to the lamp's power: hidden while off, shown while on. %>
        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Zonen"<%= " hidden".html_safe unless snapshot.on? %>>
          <% snapshot.zones.each do |zone| %>
            <%= render Lights::ZoneComponent.new(zone: zone, light_key: light.key) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
