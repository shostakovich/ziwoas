<div class="card mb-3" id="light_panel_white" role="tabpanel" aria-labelledby="light_tab_white"
     data-light-detail-target="panel" data-tab="white">
  <div class="card-body">
    <div class="d-flex gap-1 mb-2 small text-uppercase text-body-secondary">
      <label for="light_temp">Lichtfarbe</label><span aria-hidden="true">·</span>
      <output for="light_temp" class="text-body tabular-nums" data-light-detail-target="tempValue"><%= GermanNumber.format(slider_value, unit: "K") %></output>
    </div>
    <input class="form-range ld-range ld-white" type="range" id="light_temp"
           min="<%= light.color_temp_min_k %>" max="<%= light.color_temp_max_k %>" step="100"
           value="<%= slider_value %>"
           data-light-detail-target="temp" data-action="light-detail#temp">
    <div class="ld-ticks" aria-hidden="true">
      <% presets.each_value do |preset_kelvin| %>
        <span class="ld-tick" style="--at: <%= share(preset_kelvin) %>"></span>
      <% end %>
    </div>
    <div class="d-flex justify-content-between small text-body-secondary mt-1">
      <span><%= GermanNumber.format(light.color_temp_min_k, unit: "K") %> · warm</span>
      <span><%= GermanNumber.format(light.color_temp_max_k, unit: "K") %> · kalt</span>
    </div>
    <div class="d-flex gap-2 mt-3 ld-choices">
      <% presets.each do |label, preset_kelvin| %>
        <button type="button" class="btn btn-sm btn-outline-primary flex-fill<%= " active" if active?(preset_kelvin) %>"
                data-action="light-detail#temp" data-light-detail-target="preset"
                data-light-detail-temp-param="<%= preset_kelvin %>"
                aria-pressed="<%= active?(preset_kelvin) %>"><%= label %></button>
      <% end %>
    </div>
  </div>
</div>
