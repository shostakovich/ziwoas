<div class="card mb-3" id="light_card_<%= light.key %>" data-light-key="<%= light.key %>">
  <div class="card-body d-flex align-items-start gap-3">
    <div class="flex-grow-1">
      <%= link_to light_path(light.key), class: "d-block text-reset text-decoration-none", "aria-label": "#{light.name} Details" do %>
        <h3 class="card-title h5 mb-1"><%= light.name %></h3>
        <div class="small text-body-secondary"><%= summary %></div>
      <% end %>
      <%= link_to "Anpassen ›", light_path(light.key), class: "d-inline-block small link-secondary mt-3" %>
    </div>

    <div class="d-flex flex-column align-items-center gap-2">
      <%= button_to light_command_path(light_key: light.key),
            params: { command: "turn", on: (!snapshot.on?).to_s },
            class: "btn btn-light btn-icon sw-knob sw-lamp-knob#{' off' unless snapshot.on?}",
            aria: { label: "#{light.name} umschalten" } do %>
        <%= helpers.image_tag light.plush_image(on: snapshot.on?), alt: "", class: "sw-knob-plush" %>
      <% end %>

      <% if (current_chip = chip) %>
        <span class="badge border tabular-nums">
          <span class="sw-swatch me-1" style="background-color: <%= current_chip[:swatch] %>"></span><%= current_chip[:label] %>
        </span>
      <% end %>
    </div>
  </div>
</div>
