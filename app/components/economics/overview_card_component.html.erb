<%= render CardComponent.new(title: "Wirtschaftlichkeit", subtitle: subtitle) do %>
  <div class="row row-cols-2 row-cols-md-4 g-3 pt-2 mb-3 economics-tiles">
    <% tiles.each do |label, value| %>
      <div class="col stat">
        <span class="stat-label"><%= label %></span>
        <span class="stat-value fs-4"><%= value %></span>
      </div>
    <% end %>
  </div>

  <% if covered_pct %>
    <div class="progress mb-3" role="progressbar"
         aria-label="<%= covered_value %> der Anschaffungskosten zurückverdient"
         aria-valuenow="<%= covered_pct %>" aria-valuemin="0" aria-valuemax="100"
         data-economics-covered-pct="<%= covered_pct %>">
      <div class="progress-bar bg-warning" style="width: <%= covered_pct %>%"></div>
    </div>
  <% end %>

  <p class="small text-body-secondary">
    Gerechnet wird nur mit dem Strom, den die gemessenen Verbraucher im selben
    Moment genutzt haben. Eingespeister Strom wird nicht vergütet und zählt nicht.
  </p>

  <% if hint %>
    <p class="small text-body-secondary"><%= hint %></p>
  <% end %>

  <%= link_to (result.costed? ? "Kosten und Preise pflegen" : "Kosten erfassen"),
              economics_path, class: "btn btn-sm btn-outline-secondary" %>
<% end %>
