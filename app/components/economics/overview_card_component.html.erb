<%= render CardComponent.new(title: "Wirtschaftlichkeit", subtitle: subtitle,
                             classes: "economics-card") do %>
  <div class="row row-cols-2 row-cols-md-4 g-2 mb-3 economics-tiles">
    <%= render Dashboard::TileComponent.new(label: "Anschaffungskosten", value: cost_value) %>
    <%= render Dashboard::TileComponent.new(label: "Ersparnis", value: saved_value) %>
    <%= render Dashboard::TileComponent.new(label: "Zurückverdient", value: covered_value) %>
    <%= render Dashboard::TileComponent.new(label: payback_label, value: payback_value) %>
  </div>

  <% if covered_pct %>
    <div class="economics-bar" role="img"
         aria-label="<%= covered_value %> der Anschaffungskosten zurückverdient"
         data-economics-covered-pct="<%= covered_pct %>">
      <span style="width: <%= covered_pct %>%"></span>
    </div>
  <% end %>

  <p class="small text-body-secondary">
    Gerechnet wird nur mit dem Strom, den die gemessenen Verbraucher im selben
    Moment genutzt haben. Eingespeister Strom wird nicht vergütet und zählt nicht.
  </p>

  <% if hint %>
    <p class="small text-body-secondary"><%= hint %></p>
  <% end %>

  <p class="economics-actions">
    <%= link_to (result.costed? ? "Kosten und Preise pflegen" : "Kosten erfassen"),
                economics_path, class: "sw-btn ghost" %>
  </p>
<% end %>
