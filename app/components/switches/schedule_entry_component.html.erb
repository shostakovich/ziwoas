<div class="d-flex align-items-center flex-wrap gap-1 py-1 border-top" id="<%= row_id %>">
  <%# Only an Einzelschaltung carries an arrow: a Zeitfenster says both
      directions by having two times. %>
  <span class="<%= pill_class %>">
    <%= helpers.entry_label(entry) %>
    <% unless window? %><span class="fw-bold ms-1"><%= direction %></span><% end %>
  </span>
  <%= button_to enabled_path,
                method: :patch, params: { enabled: (!entry.enabled?).to_s },
                class: "btn btn-icon btn-sm", form_class: "ms-auto",
                "aria-label": "#{noun} #{entry.enabled? ? 'pausieren' : 'aktivieren'}" do %>
    <%= helpers.ui_icon(entry.enabled? ? :pause : :play) %>
  <% end %>
  <%= link_to edit_path, class: "btn btn-icon btn-sm", data: { turbo_stream: true },
              "aria-label": "#{noun} bearbeiten" do %>
    <%= helpers.ui_icon(:edit) %>
  <% end %>
  <%= button_to entry_path,
                method: :delete, class: "btn btn-icon btn-sm",
                form: { data: { turbo_confirm: "#{noun} wirklich löschen?" } },
                "aria-label": "#{noun} löschen" do %>
    <%= helpers.ui_icon(:delete) %>
  <% end %>
</div>
