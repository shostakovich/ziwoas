<div id="dashboard_plug_bar" class="card card-body mb-3 live-dim">
  <div class="progress-stacked" style="height: 1.5rem">
    <% consumers.each do |plug| %>
      <div class="progress h-100" role="progressbar" style="width: <%= width_pct(plug) %>%"
           aria-label="<%= plug.name %>" aria-valuenow="<%= width_pct(plug).round %>" aria-valuemin="0" aria-valuemax="100"
           title="<%= plug.name %> · <%= plug.apower_w.round %> W">
        <div class="progress-bar" style="background-color: <%= color(plug) %>"></div>
      </div>
    <% end %>
  </div>
  <div class="d-flex justify-content-between align-items-baseline mt-2 small text-body-secondary">
    <span>Verbrauch gesamt</span>
    <strong class="text-body tabular-nums"><%= total_w.round %> W</strong>
  </div>
  <ul class="list-unstyled d-flex flex-wrap row-gap-2 column-gap-3 small tabular-nums mt-3 mb-0" aria-label="Legende">
    <% producers.each do |plug| %>
      <li class="d-flex align-items-center gap-2">
        <span class="badge rounded-pill legend-dot" style="background-color: <%= PRODUCER_COLOR %>"></span>
        <span class="text-nowrap"><%= plug.name %></span>
        <span class="text-body-secondary">-<%= (plug.apower_w || 0).abs.round %> W</span>
      </li>
    <% end %>
    <% consumers.each do |plug| %>
      <li class="d-flex align-items-center gap-2">
        <span class="badge rounded-pill legend-dot" style="background-color: <%= color(plug) %>"></span>
        <span class="text-nowrap"><%= plug.name %></span>
        <span class="text-body-secondary"><%= plug.apower_w.round %> W</span>
      </li>
    <% end %>
  </ul>
</div>
