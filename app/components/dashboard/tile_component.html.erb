<%# Values sit at the foot, so a row lines them up even when a label wraps. %>
<%= tag.div class: "col", id: id do %>
  <div class="card h-100">
    <div class="card-body p-3 h-100 d-flex flex-column">
      <div class="stat flex-grow-1">
        <span class="stat-label"><%= label %></span>
        <span class="stat-value fs-2 mt-auto"><%= number %><% if unit %> <span class="fs-5 fw-semibold"><%= unit %></span><% end %></span>
        <% if caption %><span class="small text-body-secondary"><%= caption %></span><% end %>
      </div>
    </div>
  </div>
<% end %>
