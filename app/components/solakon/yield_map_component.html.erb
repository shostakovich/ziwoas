<%= render CardComponent.new(title: "Ausbeute nach Sonnenstand", data: { chart: "yield-map" }) do %>
  <% if empty? %>
    <p class="note small text-body-secondary mb-0">Die Karte füllt sich, sobald Stunden mit Einstrahlung und PV-Leistung zusammenkommen.</p>
  <% else %>
    <% skies.each do |sky| %>
      <% plot = sky.plot %>
      <svg viewBox="<%= plot.view_box %>" role="img" aria-label="Ausbeute nach Sonnenstand, Azimut über Sonnenhöhe"
           class="yield-map-<%= sky.key %> <%= frame_classes(sky) %>">
        <g class="grid"><% sky.elevation_lines(:dense).each do |line| %><line x1="<%= plot.left %>" x2="<%= plot.right %>" y1="<%= line.at %>" y2="<%= line.at %>"/><% end %></g>
        <g class="hour-labels label-<%= sky.density %>" dominant-baseline="central"><% sky.elevation_lines.each do |line| %><text x="<%= sky.elevation_label_x %>" y="<%= line.label_at %>" text-anchor="end"><%= line.text %></text><% end %></g>
        <g class="grid"><% sky.azimuth_lines.each do |line| %><line x1="<%= line.at %>" x2="<%= line.at %>" y1="<%= plot.top %>" y2="<%= plot.bottom %>"/><% end %></g>
        <g class="month-labels label-<%= sky.density %>" dominant-baseline="hanging"><% sky.azimuth_lines.each do |line| %><text x="<%= line.at %>" y="<%= line.label_at %>" text-anchor="middle"><%= line.text %></text><% end %></g>
        <g class="fields"><% sky.fields.each do |field| %><rect x="<%= field.rect.x %>" y="<%= field.rect.y %>" width="<%= field.rect.width %>" height="<%= field.rect.height %>" rx="1" style="fill: <%= field.fill %>"><title><%= field.title %></title></rect><% end %></g>
        <% sky.paths.each do |path| %>
          <g>
            <polyline class="sun" points="<%= path.points %>"/>
            <% path.dots.each do |dot| %><circle class="dot" cx="<%= dot.x %>" cy="<%= dot.y %>" r="<%= Solakon::YieldMapComponent::Sky::DOT_RADIUS %>"/><% if dot.text %><text class="dot-label" x="<%= dot.text_x %>" y="<%= dot.text_y %>" text-anchor="<%= dot.anchor %>" dominant-baseline="<%= dot.baseline %>"><%= dot.text %></text><% end %><% end %>
            <text class="path-label" x="<%= path.label_x %>" y="<%= path.label_y %>" text-anchor="<%= path.anchor %>" dominant-baseline="<%= path.baseline %>"><%= path.label %></text>
          </g>
        <% end %>
      </svg>
    <% end %>
    <ul class="legend list-unstyled d-flex flex-wrap align-items-center column-gap-3 row-gap-1 small text-body-secondary mt-2 mb-0">
      <li class="legend-item d-inline-flex align-items-center gap-2">Ausbeute 0 %<span class="legend-ramp" style="background: <%= legend_gradient %>"></span>100 %</li>
      <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-line"></span>Sonnenbahn, Punkte alle drei Stunden</li>
    </ul>
    <details class="solakon-details small text-body-secondary mt-3">
      <summary>Wie wird gerechnet?</summary>
      <p class="note mt-2 mb-0"><%= note %></p>
    </details>
  <% end %>
<% end %>
