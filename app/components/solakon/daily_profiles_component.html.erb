<section class="chart-card sun-chart" data-chart="daily-profiles">
  <% if empty? %>
    <p class="note">Der Tagesgang erscheint, sobald ein Monat Stundenwerte hat.</p>
  <% else %>
    <div class="multiples">
      <% multiples.each do |multiple| %>
        <figure class="multiple" data-month="<%= multiple.month %>">
          <figcaption><%= multiple.label %> <span><%= multiple.days %> Tage · W</span></figcaption>
          <svg viewBox="<%= view_box %>" role="img" aria-label="Tagesgang <%= multiple.label %>">
            <g class="grid"><% grid.each do |label| %><line x1="<%= plot_left %>" x2="<%= plot_right %>" y1="<%= label.y %>" y2="<%= label.y %>"/><% end %></g>
            <g class="value-labels"><% grid.each do |label| %><text x="<%= label.x %>" y="<%= label.y + 3.5 %>" text-anchor="end"><%= label.text %></text><% end %></g>
            <% %i[dense sparse].each do |density| %>
              <g class="hour-labels label-<%= density %>"><% hour_labels(density).each do |label| %><text x="<%= label.x %>" y="<%= label.y %>" text-anchor="middle"><%= label.text %></text><% end %></g>
            <% end %>
            <line class="axis" x1="<%= plot_left %>" x2="<%= plot_right %>" y1="<%= baseline_y %>" y2="<%= baseline_y %>"/>
            <% if multiple.area %><polygon class="measured-area" points="<%= multiple.area %>"/><% end %>
            <% multiple.series.each do |series| %><% series.segments.each do |points| %><polyline class="curve <%= series.key %>" points="<%= points %>"/><% end %><% end %>
            <g class="hits"><% multiple.hits.each do |hit| %><rect x="<%= hit.x %>" y="<%= plot_top %>" width="<%= hit.width %>" height="<%= plot_height %>"><title><%= hit.title %></title></rect><% end %></g>
          </svg>
        </figure>
      <% end %>
    </div>
    <ul class="legend">
      <% legend.each do |key, label| %>
        <li class="legend-item"><span class="legend-line <%= key %>"></span><%= label %></li>
      <% end %>
    </ul>
    <p class="note"><%= note %></p>
  <% end %>
</section>
