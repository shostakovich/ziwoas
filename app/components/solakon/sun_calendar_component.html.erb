<% if empty? %>
  <section class="card card-body mb-3 empty-state">
    <h2 class="card-title">Noch kein Sonnenkalender</h2>
    <p>Der Kalender erscheint, sobald die ersten Stundenwerte der PV-Leistung vorliegen.</p>
  </section>
<% else %>
  <div class="sun-charts sun-calendar">
    <% strips.each do |strip| %>
      <%= render CardComponent.new(title: strip.title, level: 3,
                                   data: { strip: strip.key }) do %>
        <% strip_plots.each do |frame, plot| %>
          <svg viewBox="<%= plot.view_box %>" role="img" aria-label="<%= strip.title %> je Stunde über das Jahr <%= year %>"
               class="strip-chart-<%= frame %> <%= frame_classes(frame) %>">
            <g class="grid"><% month_lines(plot).each do |at| %><line x1="<%= at %>" x2="<%= at %>" y1="<%= month_line_top(plot) %>" y2="<%= plot.bottom %>"/><% end %></g>
            <g class="month-labels label-<%= density(frame) %>"><% month_labels(plot, density(frame)).each do |label| %><text x="<%= label.x %>" y="<%= label.y %>"><%= label.text %></text><% end %></g>
            <g class="hour-labels label-<%= density(frame) %>" dominant-baseline="central"><% hour_labels(plot, density(frame)).each do |label| %><text x="<%= label.x %>" y="<%= label.y %>" text-anchor="end"><%= label.text %></text><% end %></g>
            <% if frame == :wide %>
              <g class="cells" id="<%= cells_id(strip) %>" shape-rendering="crispEdges"><% cells(strip).each do |group| %><g <%= tag.attributes(class: ("nodata" if group.nodata?), style: ("fill: #{group.fill}" unless group.nodata?)) %>><% group.rects.each do |cell| %><rect x="<%= cell.x %>" y="<%= cell.y %>" width="<%= cell.width %>" height="<%= cell.height %>"/><% end %></g><% end %></g>
            <% else %>
              <use class="cells" href="#<%= cells_id(strip) %>" transform="<%= cells_transform %>"/>
            <% end %>
            <% if lines? %>
              <% %i[rise set noon].each do |event| %><% sun_segments(plot, event).each do |points| %><polyline class="sun-halo" points="<%= points %>"/><polyline class="sun <%= event %>" points="<%= points %>"/><% end %><% end %>
            <% end %>
            <% if seam? && strip.key == :pv %>
              <line class="seam" x1="<%= seam_x(plot) %>" x2="<%= seam_x(plot) %>" y1="<%= plot.top %>" y2="<%= plot.bottom %>"/>
            <% end %>
            <% if hits?(frame) %>
              <g class="hits"><% hits(plot).each do |hit| %><rect x="<%= hit.rect.x %>" y="<%= hit.rect.y %>" width="<%= hit.rect.width %>" height="<%= hit.rect.height %>"><title><%= hit.title %></title></rect><% end %></g>
            <% end %>
          </svg>
        <% end %>
        <ul class="legend list-unstyled d-flex flex-wrap align-items-center column-gap-3 row-gap-1 small text-body-secondary mt-2 mb-0">
          <li class="legend-item d-inline-flex align-items-center gap-2">0<span class="legend-ramp" style="background: <%= legend_gradient(strip) %>"></span><%= legend_max(strip) %> <%= strip.unit %></li>
          <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-box nodata"></span>keine Daten</li>
          <% if seam? && strip.key == :pv %>
            <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-line seam"></span>Wechsel der Quelle</li>
          <% end %>
          <% if lines? %>
            <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-line"></span>Sonnenaufgang und Sonnenuntergang</li>
            <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-line noon"></span>Sonnenhöchststand</li>
          <% end %>
        </ul>
        <% if seam? && strip.key == :pv %>
          <p class="note small text-body-secondary mt-3 mb-0"><%= seam_note %></p>
        <% end %>
      <% end %>
    <% end %>

    <%= render CardComponent.new(title: "PV-Energie je Tag", level: 3,
                                 data: { strip: "energy" }) do %>
      <% bars_plots.each do |frame, plot| %>
        <svg viewBox="<%= plot.view_box %>" role="img" aria-label="PV-Energie je Tag über das Jahr <%= year %>"
             class="energy-chart-<%= frame %> <%= frame_classes(frame) %>">
          <g class="grid"><% month_lines(plot).each do |at| %><line x1="<%= at %>" x2="<%= at %>" y1="<%= plot.top %>" y2="<%= plot.bottom %>"/><% end %></g>
          <g class="grid"><% bar_grid_lines(plot).each do |at| %><line x1="<%= plot.left %>" x2="<%= plot.right %>" y1="<%= at %>" y2="<%= at %>"/><% end %></g>
          <g class="hour-labels" dominant-baseline="central"><% bar_grid_labels(plot).each do |label| %><text x="<%= label.x %>" y="<%= label.y %>" text-anchor="end" <%= tag.attributes(class: ("zero" if label.zero)) %>><%= label.text %></text><% end %></g>
          <% unit = bar_unit_label(plot) %><text class="unit" x="<%= unit.x %>" y="<%= unit.y %>"><%= unit.text %></text>
          <g class="month-labels label-<%= density(frame) %>" dominant-baseline="hanging"><% month_labels(plot, density(frame)).each do |label| %><text x="<%= label.x %>" y="<%= month_label_top(plot) %>"><%= label.text %></text><% end %></g>
          <g class="bars" shape-rendering="crispEdges"><% bar_areas(plot).each do |area| %><path d="<%= area %>"/><% end %></g>
          <line class="axis" x1="<%= plot.left %>" x2="<%= plot.right %>" y1="<%= plot.bottom %>" y2="<%= plot.bottom %>"/>
          <% if hits?(frame) %>
            <g class="hits"><% hits(plot).each do |hit| %><rect x="<%= hit.rect.x %>" y="<%= hit.rect.y %>" width="<%= hit.rect.width %>" height="<%= hit.rect.height %>"><title><%= hit.title %></title></rect><% end %></g>
          <% end %>
        </svg>
      <% end %>
      <p class="small text-body-secondary mt-2 mb-0">Tage ohne Stundenwerte bleiben leer.</p>
    <% end %>
  </div>
<% end %>
