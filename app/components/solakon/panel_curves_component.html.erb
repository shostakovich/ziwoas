<%= render CardComponent.new(title: "Die vier Panels im Tagesverlauf", subtitle: period,
                             data: { chart: "panels" }) do %>
  <% if empty? %>
    <p class="note small text-body-secondary mb-0">Der Vergleich erscheint, sobald alle vier Panels einen Tag lang geliefert haben.</p>
  <% else %>
    <% charts.each do |chart| %>
      <svg viewBox="<%= chart.plot.view_box %>" role="img" aria-label="Stundenmittel je Panel über den Tag"
           class="panel-chart panel-chart-<%= chart.key %> <%= chart.named? ? 'd-none d-sm-block' : 'd-sm-none' %>">
        <g class="grid"><% chart.grid_lines.each do |at| %><line x1="<%= chart.plot.left %>" x2="<%= chart.plot.right %>" y1="<%= at %>" y2="<%= at %>"/><% end %></g>
        <g class="value-labels" dominant-baseline="central">
          <% chart.value_labels.each do |label| %><text x="<%= label.x %>" y="<%= label.y %>" text-anchor="end"><%= label.text %></text><% end %>
          <% unit = chart.unit_label %><text class="unit" x="<%= unit.x %>" y="<%= unit.y %>" text-anchor="end"><%= unit.text %></text>
        </g>
        <g class="hour-labels" dominant-baseline="hanging"><% chart.hour_labels.each do |label| %><text x="<%= label.x %>" y="<%= label.y %>" text-anchor="middle"><%= label.text %></text><% end %></g>
        <line class="axis" x1="<%= chart.plot.left %>" x2="<%= chart.plot.right %>" y1="<%= chart.plot.bottom %>" y2="<%= chart.plot.bottom %>"/>
        <% chart.series.each do |panel| %><% panel.segments.each do |points| %><polyline class="curve <%= panel.key %>" points="<%= points %>"/><% end %><% end %>
        <% if chart.named? %>
          <g class="direct-labels"><% chart.labels.each do |label| %><text class="<%= label.key %>" x="<%= label.x %>" y="<%= label.y %>"><%= label.text %></text><% end %></g>
        <% end %>
        <g class="hits"><% chart.hits.each do |hit| %><rect x="<%= hit.rect.x %>" y="<%= hit.rect.y %>" width="<%= hit.rect.width %>" height="<%= hit.rect.height %>"><title><%= hit.title %></title></rect><% end %></g>
      </svg>
    <% end %>
    <ul class="legend list-unstyled d-flex flex-wrap align-items-center column-gap-3 row-gap-1 small text-body-secondary mt-2 mb-0">
      <% legend.each do |entry| %>
        <li class="legend-item d-inline-flex align-items-center gap-2"><span class="legend-line <%= entry.key %>"></span><%= entry.label %></li>
      <% end %>
    </ul>
    <p class="note small text-body-secondary mt-3 mb-0"><%= note %></p>
  <% end %>
<% end %>
